# Root domain for all local services
HOST_DOMAIN=docker.so

# Prefix for containers
PREFIX=runestone

# Stonehenge major version
RUNESTONE_VERSION=5

# Image versions
RUNESTONE_IMAGE=cymondez/runestone
RUNESTONE_TAG=5.2

# Traefik 
WEB_ENTRYPOINT_PORT=80
WEB_ENTRYPOINT_NAME=web
WEB_SECURE_ENTRYPOINT_PORT=443
WEB_SECURE_ENTRYPOINT_NAME=websecure